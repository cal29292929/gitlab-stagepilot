# GitLab StagePilot Configuration
# Works out-of-the-box in Local Sandbox/Demo mode without external API keys.
# Set variables below to enable Live GitLab API + Anthropic Claude + Google Vertex AI mode.

STAGEPILOT_MODE=demo                  # "demo" or "live"
STAGEPILOT_AUTONOMY_MODE=hands_off    # "assisted", "supervised", or "hands_off"
STAGEPILOT_PORT=8080

# GitLab Integration (Optional for demo mode, required for live mode)
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=12345678
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=stagepilot-webhook-secret

# Anthropic Claude API (via GitLab Duo / Direct API)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Google Cloud & Vertex AI Integration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
